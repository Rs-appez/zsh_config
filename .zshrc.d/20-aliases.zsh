alias q="exit"
alias shut="shutdown -h now"
alias open="xdg-open"

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"
alias mkdir="mkdir -p"
alias ls="ls --color=auto"

# neovim
alias cco="nt -S ~/.config/nvim/chatWithCopilot.lua"

# terminal tools
alias lg="lazygit"
alias lzs="lazysql"
alias y="yazi"
alias lzd="lazydocker"
alias icat="kitty +kitten icat --align=left"

# misc
alias trig="tree --gitignore --dirsfirst -C -L 2"

